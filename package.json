{
  "name": "telisik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI verification of startup spending reports with tranche escrow on Monad",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "demo": "node scripts/demo.mjs",
    "web:build": "node scripts/build-web.mjs",
